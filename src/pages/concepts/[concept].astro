---
import { sitePath } from '../../lib/navigation/paths';
import { getCollection } from 'astro:content';
import AtlasLayout from '../../layouts/AtlasLayout.astro';
export async function getStaticPaths() { return (await getCollection('concepts')).map((entry) => ({ params: { concept: entry.data.id }, props: { entry } })); }
const { entry } = Astro.props;
const { data } = entry;
const all = await getCollection('concepts');
const related = all.filter((entry) => data.related.includes(entry.data.id));
const prerequisites = all.filter((entry) => data.prerequisites.includes(entry.data.id));
const occurrences = (await getCollection('chapters')).flatMap(({ data: chapter }) => chapter.steps.filter((step) => step.conceptIds.includes(data.id)).map((step) => ({ chapter, step })));
const first = occurrences.find(({ step }) => step.id === data.stepId) || occurrences[0];
const contextUrl = sitePath(first ? `/courses/${first.chapter.courseId}/${first.chapter.slug}/core/#${first.step.id}` : '/concepts/');
---
<AtlasLayout title={data.title}><main id="main" tabindex="-1"><section class="hero"><div class="eyebrow">Теория игр / Понятие</div><div class="hero-grid"><h1>{data.title}</h1></div></section><div class="narrative"><p class="course-intro">{data.definition}</p><p class="note">Формулировка из первой главы. Полное объяснение включает условия и примеры.</p><div class="actions"><a class="primary" href={contextUrl}>Разобраться в контексте →</a></div>{occurrences.length > 1 && <section class="quick-section"><h2>Где встречается</h2><ul>{occurrences.map(({ chapter, step }) => <li><a href={sitePath(`/courses/${chapter.courseId}/${chapter.slug}/core/#${step.id}`)}>Глава {chapter.number} · {step.title}</a></li>)}</ul></section>}{prerequisites.length > 0 && <section class="quick-section"><h2>Полезно сначала</h2><div class="concept-links">{prerequisites.map(({ data }) => <a href={sitePath(`/concepts/${data.id}/`)}>{data.title}</a>)}</div></section>}{related.length > 0 && <section class="quick-section"><h2>Связанные понятия</h2><div class="concept-links">{related.map(({ data }) => <a href={sitePath(`/concepts/${data.id}/`)}>{data.title}</a>)}</div></section>}</div><div class="actions"><a class="secondary" href={sitePath('/concepts/')}>Все понятия</a></div></main></AtlasLayout>
