---
import { getUI } from '../../i18n/ui';
import type { Chapter } from '../../lib/content/schema';
interface Props { id: string; chapter: Chapter }
const { id, chapter } = Astro.props;
const t = getUI(chapter.locale);
const index = chapter.steps.findIndex((s) => s.id === id);
const step = chapter.steps[index];
if (!step) throw new Error(`Unknown step: ${id}`);
const time = (seconds: number) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
const video = new URL(chapter.videoUrl || chapter.sourceUrl);
if (chapter.videoUrl) video.searchParams.set('t', `${step.sourceStart}s`);
---
<section class="core-step" id={id} data-core-step={id} data-initial={index === 0 || undefined} aria-label={step.title}>
  <div class="eyebrow step-kicker"><strong>{String(index + 1).padStart(2, '0')}</strong> Core / {String(chapter.steps.length).padStart(2, '0')}</div>
  <slot />
  <footer class="step-footer">
    <div class="source-ref">{t.originalSource}<br /><a href={video.href} target="_blank" rel="noopener noreferrer">{time(step.sourceStart)}–{time(step.sourceEnd)} ↗<span class="sr-only">{t.videoFragment}</span></a></div>
    <button type="button" class="primary js-only" data-complete-step={id}>{index === chapter.steps.length - 1 ? t.finishCore.replace(' →', '') : t.continue.replace(' →', '')} <span aria-hidden="true">→</span></button>
  </footer>
</section>
