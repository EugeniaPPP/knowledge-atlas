---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import type { Chapter, Mode, Locale } from '../../lib/content/schema';
interface Props { chapter: Chapter; mode: Mode; locale: Locale; entry: CollectionEntry<'lessons'> }
const { chapter, mode, locale, entry } = Astro.props;
const { Content } = await render(entry);
const notesEntry = (await getCollection('sourceNotes')).find(({ data }) => data.chapterId === chapter.id && data.locale === locale);
if (!notesEntry) throw new Error(`Missing editorial notes: ${chapter.id}/${locale}`);
const Notes = (await render(notesEntry)).Content;
---
<ChapterLayout chapter={chapter} mode={mode}><Content /><Fragment slot="source-notes"><Notes /></Fragment></ChapterLayout>
