---
import type { Locale } from '../../lib/content/schema';
import { languagePath } from '../../lib/navigation/paths';
import { getUI } from '../../i18n/ui';
const { locale = 'ru' } = Astro.props as { locale: Locale };
const names = { ru: 'Русский', en: 'English' };
---
<nav class="language-switcher" aria-label={getUI(locale).language}>
  {(['ru', 'en'] as const).map((language) => <a href={languagePath(Astro.url.pathname.includes('/404') ? import.meta.env.BASE_URL : Astro.url.pathname, language)} hreflang={language} lang={language} aria-label={names[language]} aria-current={language === locale ? 'page' : undefined} data-language-link><span class="language-name">{names[language]}</span><span class="language-code" aria-hidden="true">{language.toUpperCase()}</span></a>)}
</nav>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => link.addEventListener('click', () => {
    const threshold = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) + 64;
    const section = [...document.querySelectorAll<HTMLElement>('[data-core-step], article.question, section.question[id]')].find((el) => {
      const rect = el.getBoundingClientRect(); return !el.hidden && rect.top <= threshold && rect.bottom > threshold;
    });
    const hash = section?.id || window.location.hash.slice(1);
    if (hash) link.hash = hash;
  }));
</script>
