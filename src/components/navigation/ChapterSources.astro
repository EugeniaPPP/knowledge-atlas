---
import type { Chapter } from '../../lib/content/schema';
import { getUI } from '../../i18n/ui';
// Ancillary view inside the shared course drawer.
interface Props { chapter: Chapter }
const { chapter } = Astro.props;
const locale = chapter.locale, t = getUI(locale);
---
  <section class="dialog-body" data-course-view="sources" hidden>
    <div class="dialog-top"><div><button class="text-button sources-back" data-course-back>{t.backToContents}</button><div class="eyebrow">{t.ancillary} · {t.chapter} {String(chapter.number).padStart(2, '0')}</div><h2 id="sources-heading">{t.sourcesHeading}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeSources}>×</button></form></div>
    <ul class="source-list">
      {chapter.sourceLinks.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}
    </ul>
    <p class="note">{t.timestampsNote}</p>
    <details class="dialog-disclosure"><summary>{t.editorialTimes}</summary><div class="editorial-notes"><slot /></div></details>
    <details class="dialog-disclosure">
      <summary>{t.transferProgress}</summary><p class="note">{t.localData}</p>
      <p class="storage-message" data-storage-message role="status"></p>
      <div class="actions"><button class="secondary" data-export>{t.export}</button><button class="text-button" data-reset>{t.reset}</button></div>
      <label class="file-label" for="import-progress">{t.import}</label><input type="file" id="import-progress" accept=".json,application/json" />
      <p class="note" id="import-status" role="status"></p>
    </details>
  </section>
