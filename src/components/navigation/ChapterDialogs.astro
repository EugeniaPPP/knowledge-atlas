---
import type { Chapter } from '../../lib/content/schema';
import { getCollection } from 'astro:content';
import { getUI } from '../../i18n/ui';
import { sitePath } from '../../lib/navigation/paths';
interface Props { chapter: Chapter }
const { chapter } = Astro.props;
const locale = chapter.locale, t = getUI(locale);
const base = sitePath(`/courses/${chapter.courseId}/${chapter.slug}`, locale);
const concepts = (await getCollection('concepts')).filter((c) => c.data.locale === locale && chapter.conceptIds.includes(c.data.id));
---
<dialog id="contents-dialog" aria-labelledby="contents-heading">
  <div class="dialog-body">
    <div class="dialog-top"><div><div class="eyebrow">{t.currentChapter} · {String(chapter.number).padStart(2, '0')}</div><h2 id="contents-heading">{t.contents}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeContents}>×</button></form></div>
    <p class="note">{chapter.title}</p><p class="note">{t.openSections}</p>
    <ol class="toc">{chapter.steps.map((s) => <li><a href={`${base}/core/#${s.id}`} data-step-link={s.id}>{s.title}</a></li>)}</ol>
    <div class="actions"><button class="secondary" data-reveal-from-toc>{t.revealAll}</button></div>
    <div class="dialog-section"><h3>{t.relatedConcepts}</h3><div class="concept-links">{concepts.map(({ data }) => <a href={sitePath(`/concepts/${data.id}/`, locale)}>{data.title}</a>)}</div></div>
  </div>
</dialog>
<dialog id="sources-dialog" aria-labelledby="sources-heading">
  <div class="dialog-body">
    <div class="dialog-top"><div><div class="eyebrow">{t.ancillary} · {t.chapter} {String(chapter.number).padStart(2, '0')}</div><h2 id="sources-heading">{t.sourcesHeading}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeSources}>×</button></form></div>
    <ul class="source-list">
      {chapter.sourceLinks.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}
    </ul>
    <p class="note">{t.timestampsNote}</p>
    <details class="dialog-disclosure"><summary>{t.editorialTimes}</summary><div class="editorial-notes"><slot /></div></details>
    <details class="dialog-disclosure">
      <summary>{t.transferProgress}</summary><p class="note">{t.localData}</p>
      <p class="storage-message" data-storage-message role="status"></p>
      <div class="actions"><button class="secondary" data-export>{t.export}</button><button class="text-button" data-reset>{t.reset}</button></div>
      <label class="file-label" for="import-progress">{t.import}</label><input type="file" id="import-progress" accept=".json,application/json" />
      <p class="note" id="import-status" role="status"></p>
    </details>
  </div>
</dialog>
