---
import { getCollection, getEntry } from 'astro:content';
import { getUI, format } from '../../i18n/ui';
import { localizedChapters } from '../../lib/content/queries';
import type { Locale } from '../../lib/content/schema';
import { sitePath } from '../../lib/navigation/paths';
interface Props { courseId: string; locale: Locale }
const { courseId, locale } = Astro.props;
const t = getUI(locale);
const course = (await getEntry('courses', courseId))!.data;
const chapters = (await localizedChapters(locale)).filter((data) => data.courseId === courseId).map((data) => ({ data }));
const availableSlugs = new Set(chapters.map(({ data }) => data.slug));
const upcoming = course.lectures.filter((lecture) => !availableSlugs.has(lecture.slug)).slice(0, 3);
const shownLectures = course.lectures.filter((lecture) => availableSlugs.has(lecture.slug) || upcoming.includes(lecture));
const conceptIds = new Set(chapters.flatMap(({ data }) => data.conceptIds));
const concepts = (await getCollection('concepts')).filter(({ data }) => data.locale === locale && conceptIds.has(data.id));
const currentPath = Astro.url.pathname;
---
<dialog class="atlas-drawer" id="course-dialog" aria-labelledby="course-drawer-heading">
  <div class="dialog-body">
    <div class="dialog-top"><div><div class="eyebrow">{t.wholeCourse} · Yale ECON 159</div><h2 id="course-drawer-heading">{t.courseChapters}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeCourse}>×</button></form></div>
    <p class="drawer-intro">{locale === 'en' ? course.titleEn : course.title}<span>{format(t.available, { count: chapters.length, total: course.lectures.length })}</span></p>
    <ol class="drawer-chapters">{shownLectures.map((lecture) => {
      const chapter = chapters.find(({ data }) => data.slug === lecture.slug)?.data;
      const href = sitePath(`/courses/${courseId}/${lecture.slug}/core/`, locale);
      return <li>{chapter ? <a href={href} aria-current={currentPath.startsWith(sitePath(`/courses/${courseId}/${lecture.slug}/`, locale)) ? 'location' : undefined}><span class="drawer-number">{String(lecture.number).padStart(2, '0')}</span><span>{chapter.title}<small>{t.openChapter}</small></span></a> : <div class="drawer-planned"><span class="drawer-number">{String(lecture.number).padStart(2, '0')}</span><span>{lecture.title}<small>{t.planned}</small></span></div>}</li>;
    })}</ol>
    <p class="note">{format(t.fullProgram, { total: course.lectures.length })}</p>
    <div class="drawer-footer"><a class="secondary" href={sitePath(`/courses/${courseId}/`, locale)}>{t.courseOverview}</a></div>
  </div>
</dialog>
<dialog class="atlas-drawer" id="concepts-dialog" aria-labelledby="concepts-drawer-heading">
  <div class="dialog-body">
    <div class="dialog-top"><div><div class="eyebrow">{t.wholeCourse} · {t.glossary}</div><h2 id="concepts-drawer-heading">{t.courseConcepts}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeConcepts}>×</button></form></div>
    <p class="note">{t.conceptDrawerIntro}</p>
    <ul class="drawer-concepts">{concepts.map(({ data }) => <li><a href={sitePath(`/concepts/${data.id}/`, locale)} aria-current={currentPath === sitePath(`/concepts/${data.id}/`, locale) ? 'page' : undefined}><strong>{data.title}<span aria-hidden="true">→</span></strong><span>{data.definition}</span></a></li>)}</ul>
    <div class="drawer-footer"><a class="secondary" href={sitePath('/concepts/', locale)}>{t.allConceptsLinks}</a></div>
  </div>
</dialog>
