---
import { getCollection, getEntry } from 'astro:content';
import { getUI, format } from '../../i18n/ui';
import { localizedChapters } from '../../lib/content/queries';
import ChapterSources from './ChapterSources.astro';
import type { Chapter, Locale } from '../../lib/content/schema';
import { sitePath } from '../../lib/navigation/paths';
interface Props { courseId: string; locale: Locale; chapter?: Chapter }
const { courseId, locale, chapter: currentChapter } = Astro.props;
const t = getUI(locale);
const course = (await getEntry('courses', courseId))!.data;
const chapters = (await localizedChapters(locale)).filter((data) => data.courseId === courseId).map((data) => ({ data }));
const conceptIds = new Set(chapters.flatMap(({ data }) => data.conceptIds));
const concepts = (await getCollection('concepts')).filter(({ data }) => data.locale === locale && conceptIds.has(data.id));
const currentPath = Astro.url.pathname;
---
<dialog class="atlas-drawer" id="course-dialog" aria-labelledby="course-drawer-heading">
  <div class="dialog-body" data-course-view="contents">
    <div class="dialog-top"><div><div class="eyebrow">{t.wholeCourse} · Yale ECON 159</div><h2 id="course-drawer-heading">{t.courseContents}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeCourseContents}>×</button></form></div>
    <p class="drawer-intro">{locale === 'en' ? course.titleEn : course.title}<span>{format(t.available, { count: chapters.length, total: course.lectures.length })}</span></p>
    <nav aria-label={t.courseContents}><ol class="drawer-chapters">{course.lectures.map((lecture) => {
      const chapter = chapters.find(({ data }) => data.slug === lecture.slug)?.data;
      const href = sitePath(`/courses/${courseId}/${lecture.slug}/core/`, locale);
      const current = chapter?.id === currentChapter?.id && !!currentChapter;
      return <li>{chapter ? <details class="course-chapter" data-course-chapter={chapter.slug} data-current-chapter={current || undefined} open={current}>
        <summary><span class="drawer-number">{String(lecture.number).padStart(2, '0')}</span><span>{chapter.title}{current && <small>{t.currentChapter}</small>}</span><svg class="chapter-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
        <div class="course-chapter-body"><a class="text-button" href={href} data-chapter-entry>{t.openChapter}</a>
          <h3 class="eyebrow">{t.coreSections}</h3>
          {current && <p class="note">{t.openSections}</p>}
          <ol class="toc">{chapter.steps.map((step) => <li><a href={`${href}#${step.id}`} data-step-link={current ? step.id : undefined} data-step-title={current ? step.title : undefined}>{step.title}</a></li>)}</ol>
          {current && <button class="text-button" data-reveal-from-toc>{t.revealAll}</button>}
        </div>
      </details> : <div class="drawer-planned"><span class="drawer-number">{String(lecture.number).padStart(2, '0')}</span><span>{lecture.title}<small>{t.planned}</small></span></div>}</li>;
    })}</ol></nav>
    <div class="drawer-footer course-drawer-footer">
      {currentChapter && <button class="text-button" data-show-sources>{format(t.chapterSources, { number: String(currentChapter.number).padStart(2, '0') })} <span aria-hidden="true">→</span></button>}
      <a class="text-button" href={sitePath(`/courses/${courseId}/`, locale)}>{t.courseOverview}</a>
    </div>
  </div>
  {currentChapter && <ChapterSources chapter={currentChapter}><slot /></ChapterSources>}
</dialog>
<dialog class="atlas-drawer" id="concepts-dialog" aria-labelledby="concepts-drawer-heading">
  <div class="dialog-body">
    <div class="dialog-top"><div><div class="eyebrow">{t.wholeCourse} · {t.glossary}</div><h2 id="concepts-drawer-heading">{t.courseConcepts}</h2></div><form method="dialog"><button class="dialog-close" aria-label={t.closeConcepts}>×</button></form></div>
    <p class="note">{t.conceptDrawerIntro}</p>
    <ul class="drawer-concepts">{concepts.map(({ data }) => <li><a href={sitePath(`/concepts/${data.id}/`, locale)} aria-current={currentPath === sitePath(`/concepts/${data.id}/`, locale) ? 'page' : undefined}><strong>{data.title}<span aria-hidden="true">→</span></strong><span>{data.definition}</span></a></li>)}</ul>
    <div class="drawer-footer"><a class="secondary" href={sitePath('/concepts/', locale)}>{t.allConceptsLinks}</a></div>
  </div>
</dialog>
